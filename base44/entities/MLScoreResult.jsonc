{
  "name": "MLScoreResult",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "loan_id": {
      "type": "string"
    },
    "rule_based_score": {
      "type": "number",
      "description": "Original rule-based score (0-100)"
    },
    "ml_score": {
      "type": "number",
      "description": "ML-derived score (0-100)"
    },
    "combined_score": {
      "type": "number",
      "description": "Weighted combination of both scores"
    },
    "ml_score_breakdown": {
      "type": "object",
      "properties": {
        "transaction_score": {
          "type": "number"
        },
        "behavioral_score": {
          "type": "number"
        },
        "device_trust_score": {
          "type": "number"
        },
        "identity_score": {
          "type": "number"
        }
      }
    },
    "risk_flags_detected": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "bonus_factors_applied": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence_level": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "description": "Confidence in ML score based on data availability"
    },
    "recommendation": {
      "type": "string",
      "enum": [
        "approve",
        "review",
        "reject"
      ]
    },
    "explanation": {
      "type": "string",
      "description": "Human-readable explanation of score"
    }
  },
  "required": [
    "user_id"
  ]
}