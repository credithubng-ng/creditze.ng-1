{
  "name": "UserBehaviorData",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "device_info": {
      "type": "object",
      "properties": {
        "device_type": {
          "type": "string"
        },
        "os": {
          "type": "string"
        },
        "browser": {
          "type": "string"
        },
        "screen_resolution": {
          "type": "string"
        },
        "is_mobile": {
          "type": "boolean"
        },
        "device_fingerprint": {
          "type": "string"
        }
      }
    },
    "location_data": {
      "type": "object",
      "properties": {
        "ip_address": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "country": {
          "type": "string"
        },
        "is_vpn": {
          "type": "boolean"
        }
      }
    },
    "session_metrics": {
      "type": "object",
      "properties": {
        "total_sessions": {
          "type": "number"
        },
        "avg_session_duration_seconds": {
          "type": "number"
        },
        "total_page_views": {
          "type": "number"
        },
        "kyc_completion_time_minutes": {
          "type": "number"
        },
        "application_attempts": {
          "type": "number"
        },
        "form_abandonment_rate": {
          "type": "number"
        }
      }
    },
    "interaction_patterns": {
      "type": "object",
      "properties": {
        "typical_login_hours": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "days_since_registration": {
          "type": "number"
        },
        "profile_completeness_percent": {
          "type": "number"
        },
        "document_upload_attempts": {
          "type": "number"
        },
        "support_tickets_opened": {
          "type": "number"
        }
      }
    },
    "transaction_analysis": {
      "type": "object",
      "properties": {
        "avg_monthly_inflow": {
          "type": "number"
        },
        "avg_monthly_outflow": {
          "type": "number"
        },
        "salary_detected": {
          "type": "boolean"
        },
        "salary_consistency_score": {
          "type": "number"
        },
        "gambling_transactions_detected": {
          "type": "boolean"
        },
        "loan_repayments_detected": {
          "type": "number"
        },
        "bounced_debits_count": {
          "type": "number"
        },
        "account_age_months": {
          "type": "number"
        },
        "low_balance_frequency": {
          "type": "number"
        }
      }
    },
    "risk_flags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of detected risk flags"
    },
    "last_updated": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id"
  ]
}