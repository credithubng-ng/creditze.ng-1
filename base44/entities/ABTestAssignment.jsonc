{
  "name": "ABTestAssignment",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "test_id": {
      "type": "string",
      "description": "Reference to ABTestConfig"
    },
    "test_key": {
      "type": "string"
    },
    "variant_id": {
      "type": "string"
    },
    "variant_name": {
      "type": "string"
    },
    "assigned_date": {
      "type": "string",
      "format": "date-time"
    },
    "loan_type": {
      "type": "string"
    },
    "converted": {
      "type": "boolean",
      "default": false
    },
    "conversion_date": {
      "type": "string",
      "format": "date-time"
    },
    "loan_id": {
      "type": "string",
      "description": "Reference to LoanApplication if converted"
    }
  },
  "required": [
    "user_id",
    "test_id",
    "test_key",
    "variant_id"
  ]
}