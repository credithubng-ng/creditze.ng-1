{
  "name": "UserCreditLimit",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "current_limit": {
      "type": "number",
      "default": 10000
    },
    "total_loans_taken": {
      "type": "number",
      "default": 0
    },
    "successful_repayments": {
      "type": "number",
      "default": 0
    },
    "late_repayments": {
      "type": "number",
      "default": 0
    },
    "defaults": {
      "type": "number",
      "default": 0
    },
    "is_frozen": {
      "type": "boolean",
      "default": false
    },
    "freeze_reason": {
      "type": "string"
    },
    "freeze_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id"
  ]
}