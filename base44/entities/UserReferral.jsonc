{
  "name": "UserReferral",
  "type": "object",
  "properties": {
    "referrer_id": {
      "type": "string",
      "description": "User who made the referral"
    },
    "referrer_email": {
      "type": "string"
    },
    "referred_user_id": {
      "type": "string",
      "description": "User who was referred"
    },
    "referred_email": {
      "type": "string"
    },
    "referral_code": {
      "type": "string",
      "description": "Referral code used"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "converted",
        "rewarded"
      ],
      "default": "pending",
      "description": "pending: signed up, converted: took loan, rewarded: reward given"
    },
    "conversion_date": {
      "type": "string",
      "format": "date-time",
      "description": "When referred user took their first loan"
    },
    "reward_issued": {
      "type": "boolean",
      "default": false
    },
    "reward_amount": {
      "type": "number",
      "description": "Reward amount in Naira"
    }
  },
  "required": [
    "referrer_id",
    "referred_user_id",
    "referral_code"
  ]
}