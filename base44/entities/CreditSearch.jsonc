{
  "name": "CreditSearch",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "search_date": {
      "type": "string",
      "format": "date-time"
    },
    "expiry_date": {
      "type": "string",
      "format": "date-time",
      "description": "90 days from search date"
    },
    "fee_paid": {
      "type": "number",
      "description": "Search fee in Naira"
    },
    "payment_reference": {
      "type": "string"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "failed"
      ],
      "default": "pending"
    },
    "search_status": {
      "type": "string",
      "enum": [
        "pending",
        "successful",
        "unsuccessful"
      ],
      "default": "pending"
    },
    "bureau_score": {
      "type": "number",
      "description": "Credit bureau score"
    },
    "bureau_response": {
      "type": "object",
      "description": "Raw response from credit bureau"
    },
    "report_url": {
      "type": "string",
      "description": "URL to credit report PDF"
    },
    "report_emailed": {
      "type": "boolean",
      "default": false
    },
    "failure_reason": {
      "type": "string"
    }
  },
  "required": [
    "user_id"
  ]
}