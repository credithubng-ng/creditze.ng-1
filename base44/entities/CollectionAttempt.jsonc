{
  "name": "CollectionAttempt",
  "type": "object",
  "properties": {
    "loan_id": {
      "type": "string",
      "description": "Reference to the loan"
    },
    "user_id": {
      "type": "string"
    },
    "attempt_type": {
      "type": "string",
      "enum": [
        "reminder_email",
        "reminder_sms",
        "overdue_email",
        "overdue_sms",
        "demand_letter",
        "final_notice",
        "phone_call",
        "direct_debit_attempt"
      ],
      "description": "Type of collection attempt"
    },
    "status": {
      "type": "string",
      "enum": [
        "sent",
        "delivered",
        "failed",
        "responded",
        "paid"
      ],
      "default": "sent"
    },
    "channel": {
      "type": "string",
      "enum": [
        "email",
        "sms",
        "phone",
        "letter",
        "direct_debit"
      ]
    },
    "message_content": {
      "type": "string"
    },
    "response_notes": {
      "type": "string"
    },
    "initiated_by": {
      "type": "string",
      "enum": [
        "system",
        "admin"
      ],
      "default": "system"
    },
    "admin_id": {
      "type": "string"
    },
    "days_overdue": {
      "type": "number"
    },
    "amount_outstanding": {
      "type": "number"
    }
  },
  "required": [
    "loan_id",
    "user_id",
    "attempt_type"
  ]
}