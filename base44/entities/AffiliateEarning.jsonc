{
  "name": "AffiliateEarning",
  "type": "object",
  "properties": {
    "affiliate_id": {
      "type": "string"
    },
    "loan_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "revenue_type": {
      "type": "string",
      "enum": [
        "interest",
        "fee"
      ],
      "description": "Type of revenue earned"
    },
    "revenue_amount": {
      "type": "number",
      "description": "Total revenue amount"
    },
    "commission_rate": {
      "type": "number"
    },
    "commission_amount": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "settled",
        "paid"
      ],
      "default": "pending"
    },
    "settled_date": {
      "type": "string",
      "format": "date-time"
    },
    "paid_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "affiliate_id",
    "loan_id",
    "revenue_type",
    "revenue_amount"
  ]
}