{
  "name": "DirectDebitMandate",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "loan_id": {
      "type": "string"
    },
    "bank_name": {
      "type": "string"
    },
    "account_number": {
      "type": "string"
    },
    "account_name": {
      "type": "string"
    },
    "mandate_reference": {
      "type": "string",
      "description": "Unique mandate reference from payment provider"
    },
    "max_amount": {
      "type": "number",
      "description": "Maximum debit amount authorized"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "suspended",
        "cancelled",
        "expired"
      ],
      "default": "pending"
    },
    "authorization_date": {
      "type": "string",
      "format": "date-time"
    },
    "expiry_date": {
      "type": "string",
      "format": "date-time"
    },
    "last_debit_date": {
      "type": "string",
      "format": "date-time"
    },
    "last_debit_amount": {
      "type": "number"
    },
    "total_debited": {
      "type": "number",
      "default": 0
    },
    "failed_attempts": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "user_id",
    "loan_id",
    "bank_name",
    "account_number"
  ]
}